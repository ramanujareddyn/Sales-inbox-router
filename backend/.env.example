# Your own Gemini API key (free tier is fine). Never commit the real value.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for classification + chat phrasing.
GEMINI_MODEL=gemini-2.0-flash

# Any SQLAlchemy URL that survives a restart.
# Local dev default (fine for testing, NOT fine for deployment on free-tier hosts
# whose disk is wiped on cold start/restart):
DATABASE_URL=sqlite:///./data.db

# Production example (Supabase / any managed Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/postgres

# Comma-separated list of origins allowed to call this API (your deployed frontend URL).
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Your candidate_id (lowercased email). Used only as a default/sanity-check on the server side.
CANDIDATE_ID=priya.sharma@gmail.com
